#!/usr/bin/env python3
"""Launcher for the terminal UI (tui/magibt.py). Symlink it onto PATH; it finds the repo through the link."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))  # repo root, so `magibt` and `tui` import

from tui.magibt import main  # noqa: E402

sys.exit(main())
